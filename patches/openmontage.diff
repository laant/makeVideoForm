+        try:
+            part = resp.json()["candidates"][0]["content"]["parts"][0]["inlineData"]
+            audio_b64, mime = part["data"], part.get("mimeType", "audio/L16;rate=24000")
+        except (KeyError, IndexError):
+            return ToolResult(success=False,
+                              error=f"Gemini TTS: no audio in response: {resp.text[:200]}")
+        pcm = base64.b64decode(audio_b64)
+        rate = "24000"
+        if "rate=" in mime:
+            rate = mime.split("rate=")[1].split(";")[0]
+
+        output_path = Path(inputs.get("output_path", "tts_output.mp3"))
+        output_path.parent.mkdir(parents=True, exist_ok=True)

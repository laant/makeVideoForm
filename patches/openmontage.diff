index f47dd4d..17e4c1d 100644
--- a/tools/audio/google_tts.py
+++ b/tools/audio/google_tts.py
@@ -187,6 +187,17 @@ class GoogleTTS(BaseTool):
         return round(char_count * rate_per_char, 4)
 
     def execute(self, inputs: dict[str, Any]) -> ToolResult:
+        # Gemini-native TTS (models/*-tts*): Cloud Text-to-Speech now rejects
+        # API keys ("Expected OAuth2 access token"), so API-key-only setups
+        # route through the Gemini API's TTS models instead.
+        model = inputs.get("model", "")
+        if model.startswith("gemini-") or (
+            not service_account_configured() and self._get_api_key()
+        ):
+            return self._execute_gemini_tts(
+                inputs, model or "gemini-3.1-flash-tts-preview"
+            )
+
         # Prefer an API key (cheapest path); otherwise mint a Bearer token from
         # the service-account JSON. This is what makes
         # GOOGLE_APPLICATION_CREDENTIALS actually work for TTS.
@@ -218,6 +229,73 @@ class GoogleTTS(BaseTool):
         result.cost_usd = self.estimate_cost(inputs)
         return result
 
+    # Gemini TTS 프리빌트 보이스 (언어 공통; ko-KR 포함 다국어 지원)
+    _GEMINI_VOICES = {"Aoede", "Kore", "Leda", "Zephyr", "Puck", "Charon", "Orus", "Fenrir"}
+
+    def _execute_gemini_tts(self, inputs: dict[str, Any], model: str) -> ToolResult:
+        """Gemini API 네이티브 TTS 경로 (API 키 인증). PCM 응답을 ffmpeg 로 mp3 변환."""
+        import requests
+        import subprocess
+        import tempfile
+
+        start = time.time()
+        api_key = self._get_api_key()
+        if not api_key:
+            return ToolResult(success=False, error="No Google API key found. " + self.install_instructions)
+
+        text = inputs["text"]
+        # "ko-KR-Chirp3-HD-Aoede" 같은 Cloud 보이스명이 오면 프리빌트 이름만 추출
+        raw_voice = inputs.get("voice", "Aoede")
+        voice = raw_voice.split("-")[-1] if "-" in raw_voice else raw_voice
+        if voice not in self._GEMINI_VOICES:
+            voice = "Aoede"
+        delivery_note = inputs.get("delivery_note", "")
+        prompt = (f"{delivery_note}\n다음 문장을 자연스럽게 읽어주세요:\n{text}"
+                  if delivery_note else text)
+
+        url = (f"https://generativelanguage.googleapis.com/v1beta/models/"
+               f"{model}:generateContent?key={api_key}")
+        payload = {

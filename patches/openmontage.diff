+            f.write(pcm)
+            raw_path = f.name
+        subprocess.run(["ffmpeg", "-y", "-v", "error", "-f", "s16le", "-ar", rate,
+                        "-ac", "1", "-i", raw_path, str(output_path)], check=True)
+        os.unlink(raw_path)
+
+        return ToolResult(
+            success=True,
+            data={"provider": self.provider, "voice": f"{model}/{voice}",
+                  "text_length": len(text), "output": str(output_path),
+                  "format": "MP3", "duration_hint_seconds": len(pcm) / 2 / int(rate)},
+            artifacts=[str(output_path)],
+            model=f"google-tts/{model}/{voice}",
+            duration_seconds=time.time() - start,
+        )

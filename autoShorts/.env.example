# ── ElevenLabs ─────────────────────────────────────────────
ELEVENLABS_API_KEY=
# Voices → My Voices 에서 복제한 목소리의 voice_id (episode.json voice.voiceId 가 우선)
ELEVENLABS_VOICE_ID=zgDzx5jLLCqEp6Fl7Kl7
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ── YouTube (Google Cloud → OAuth 클라이언트 ID: "데스크톱 앱") ──
YT_CLIENT_ID=
YT_CLIENT_SECRET=
# private | unlisted | public
YT_PRIVACY=private
# publish 기본 예약 공개: 업로드 시점 + N분 (0 이면 예약 없이 YT_PRIVACY 로 즉시)
YT_SCHEDULE_DELAY_MIN=10
# 업로드 대상 채널 핸들 — 토큰 채널과 다르면 publish 중단
YT_CHANNEL_HANDLE=

# ── Instagram Graph API (비즈니스/크리에이터 계정) ──────────
IG_USER_ID=
IG_ACCESS_TOKEN=
# Facebook 로그인 토큰이면 graph.facebook.com, Instagram 로그인 토큰이면 graph.instagram.com
IG_GRAPH_HOST=graph.facebook.com
IG_GRAPH_VERSION=v23.0

# ── Google Gemini TTS (episode.json voice.provider = "gemini") ──
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_VOICE=Aoede
# 단어 타임스탬프 추출용 whisper.cpp 다국어 모델 (없으면 자동 다운로드)
# WHISPER_MODEL=.cache/whisper/ggml-small.bin
